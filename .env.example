# Copy to `.env` (git-ignored) and edit. Every VITE_* value is compiled into the
# browser bundle: never put secrets, keys, or tokens here.

# Default data mode: synthetic | live  (live is not available until BD-1 is resolved)
VITE_DATA_MODE=synthetic

# Foundry links. Leave empty to hide "Open in Foundry". Easiest: open one agent in the
# Foundry portal, copy the address, and paste it in the app's Settings page — it derives the
# template below automatically (the subscription, resource group, account, project, and tenant
# in the link's nextgen/r/… prefix are constant for your deployment; only the agent name varies).
# To ship links with zero per-user setup, set VITE_FOUNDRY_AGENT_URL_TEMPLATE here before building.
# {agent_id} is the Foundry agent name. https only. Shape (fill in your own ids):
#   https://ai.azure.com/nextgen/r/<encoded-sub>,<resource-group>,,<account>,<project>/build/agents/{agent_id}/build?tid=<tenant-id>
# Placeholder: {agent_id}
VITE_FOUNDRY_AGENT_URL_TEMPLATE=
# Placeholders: {agent_id}, {run_id}
VITE_FOUNDRY_RUN_URL_TEMPLATE=
# Placeholder: {index_id} (the Foundry vector store id). Paste a knowledge index link in Settings
# to derive it, or set it here. Shape:
#   https://ai.azure.com/nextgen/r/<prefix>/build/knowledge/indexes/project-vectorstore/{index_id}?tid=<tenant-id>
VITE_FOUNDRY_INDEX_URL_TEMPLATE=
VITE_FOUNDRY_LINK_LABEL=Open in Foundry

# Fabric connection values (VITE_RAYFIN_API_URL, VITE_RAYFIN_PUBLISHABLE_KEY,
# VITE_FABRIC_WORKSPACE_ID, VITE_FABRIC_ITEM_ID, VITE_FABRIC_PORTAL_URL) are written
# to `.env.local` by the Rayfin CLI during `npm run deploy` / `npm run dev:fabric`.
# Do not set them by hand.
